{
	"name": "job-ranger",
	"version": "0.0.0",
	"private": true,
	"description": "Finds and ranks jobs against your own rules, tracks every application, and flags scams, ghost jobs and missing pay.",
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"cf-typegen": "rm -rf .svelte-kit/cloudflare && wrangler types",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit -p e2e",
		"lint": "svelte-kit sync && eslint . --max-warnings 0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"e2e:seed": "wrangler d1 execute DB --local --file e2e/seed.sql",
		"map:states": "node scripts/us-states.ts && prettier --write src/lib/geo/us-states.json",
		"e2e:serve": "npm run build && npm run db:migrate:local && npm run e2e:seed && wrangler dev --port 4173 --var ACCESS_LOCAL_DEV:true",
		"deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.1",
		"@cloudflare/vitest-plugin": "^1.9.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.65.0",
		"@sveltejs/adapter-cloudflare": "^8.0.3",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/d3-geo": "^3.1.1",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"@types/node": "^22",
		"@types/topojson-client": "^3.1.5",
		"@types/topojson-simplify": "^3.0.3",
		"@types/topojson-specification": "^1.0.5",
		"@vitest/coverage-istanbul": "^5.1.1",
		"d3-geo": "^3.1.2",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"fast-check": "^4.10.3",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.4.6",
		"topojson-client": "^3.1.0",
		"topojson-simplify": "^3.0.3",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.58.1",
		"us-atlas": "^3.0.1",
		"vite": "^8.0.12",
		"vitest": "^5.1.1",
		"wrangler": "^4.166.0"
	},
	"overrides": {
		"playwright-core": "$@playwright/test"
	},
	"dependencies": {
		"d3-scale": "^4.0.3",
		"d3-shape": "^3.2.1",
		"gsap": "^3.15.1",
		"jose": "^6.2.18"
	}
}
