{
	"name": "job-ranger",
	"version": "0.0.0",
	"private": true,
	"description": "Finds and ranks jobs against your own rules, tracks every application, and flags scams, ghost jobs and missing pay.",
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"cf-typegen": "wrangler types",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit -p e2e",
		"lint": "eslint . --max-warnings 0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.65.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.3.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^22",
		"@vitest/coverage-v8": "^4.1.3",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.4.6",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.12",
		"vitest": "^4.1.3",
		"wrangler": "^4.81.0"
	},
	"overrides": {
		"playwright-core": "$@playwright/test"
	}
}
