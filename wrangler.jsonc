{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "job-ranger",
	"compatibility_date": "2026-11-17",
	"compatibility_flags": ["nodejs_als"],
	// SvelteKit's worker plus the daily cron. Build first: `npm run build`.
	"main": "worker/index.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			// Created by the first deploy (2026-11-17). The ID isn't a secret.
			"binding": "DB",
			"database_name": "job-ranger",
			"database_id": "b13e4449-dd5e-46e3-8cd2-fdba06d223b0",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		// The daily fetch, at 11:23 UTC (5:23 or 6:23 in Chicago). Off the hour,
		// when cron traffic is heaviest.
		"crons": ["23 11 * * *"]
	},
	"observability": {
		"enabled": true
	},
	"workers_dev": true,
	// No preview URLs: nothing uses them, so there is nothing extra to protect.
	"preview_urls": false
}
