{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "job-ranger",
	"compatibility_date": "2026-11-17",
	"compatibility_flags": ["nodejs_als"],
	// No `main`: the SvelteKit adapter builds the Worker and its assets, and
	// points `wrangler deploy` at its output. Build first: `npm run build`.
	// The daily cron runs in its own Worker, job-ranger-daily
	// (cron/wrangler.jsonc, design note 0010).
	"assets": {
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			// Created by the first deploy (2026-11-17). The ID isn't a secret.
			"binding": "DB",
			"database_name": "job-ranger",
			"database_id": "b13e4449-dd5e-46e3-8cd2-fdba06d223b0",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		// None: the daily fetch moved to job-ranger-daily (design note 0010).
		// An empty list, not a missing key, so a deploy removes the old schedule.
		"crons": []
	},
	"observability": {
		"enabled": true
	},
	"workers_dev": true,
	// No preview URLs: nothing uses them, so there is nothing extra to protect.
	"preview_urls": false
}
