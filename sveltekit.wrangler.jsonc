// Read only by the SvelteKit adapter at build time: it writes SvelteKit's
// worker to `main` below. The deployed Worker's real entry point is
// worker/index.js (see wrangler.jsonc), which adds the daily cron to it.
// Keep the assets settings the same as in wrangler.jsonc.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "job-ranger",
	"compatibility_date": "2026-11-17",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	}
}
